# Exclude everything. The Docker image consumes only the staged internal Docker build context,
# the vendored SQLite amalgamation source, and the Docker smoke helper scripts.
# Build the assembly inputs first: ./gradlew :cli:stageDockerBuildContext
**

# Allow the Docker build inputs staged by the CLI assembly flow.
!gradle.properties
!scripts/
!cli/
!cli/build/
!cli/build/docker-context/
!cli/build/docker-context/**

# Allow the vendored SQLite3 Multiple Ciphers amalgamation source compiled inside the builder.
!third_party/
!third_party/sqlite/
!third_party/sqlite/sqlite3mc-amalgamation-2.3.3-sqlite-3530000/
!third_party/sqlite/sqlite3mc-amalgamation-2.3.3-sqlite-3530000/sqlite3mc_amalgamation.c

# Allow root legal files for inclusion in the published container image.
!LICENSE
!LICENSE-APACHE-2.0
!LICENSE-SIL-OFL-1.1
!LICENSE-SQLITE3MULTIPLECIPHERS
!NOTICE
!PATENTS.md
