#!/bin/bash
set -uo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
readonly script_dir
# shellcheck source=./common.sh
. "${script_dir}/common.sh"

fg_initialize_wrapper "$0"
if fg_has_help_flag "$@"; then
    cat <<'EOF'
Usage: jazzer/bin/fuzz-all [supported Gradle options]

Runs each active jazzer/bin/fuzz-* wrapper in order.
Stops after the first actionable failure. Bounded Jazzer completions return 0; exit 124 is reserved
for wrapper-enforced timeout teardown.
EOF
    fg_print_nested_gradle_passthrough_help
    exit 0
fi

declare -a harness_scripts=()
active_wrapper_output="$(fg_active_wrapper_scripts)"
status=$?
if [[ ${status} -ne 0 ]]; then
    exit "${status}"
fi
if [[ -n "${active_wrapper_output}" ]]; then
    while IFS= read -r harness_script; do
        harness_scripts+=("${harness_script}")
    done <<< "${active_wrapper_output}"
fi
if [[ "${#harness_scripts[@]}" -eq 0 ]]; then
    printf '%s\n' "[JAZZER-WRAPPER] No active fuzz harnesses are configured."
    exit 1
fi
readonly harness_scripts

overall_status=0

target_key_for_script() {
    local script_name
    script_name="$(basename "$1")"
    if [[ "${script_name}" != fuzz-* ]]; then
        printf '%s' ''
        return 0
    fi
    printf '%s' "${script_name#fuzz-}"
}

print_classified_findings() {
    local harness_script=$1
    local target_key

    target_key="$(target_key_for_script "${harness_script}")"
    if [[ -z "${target_key}" || ! -x "${script_dir}/list-findings" ]]; then
        return 0
    fi
    printf '%s\n' "[JAZZER-WRAPPER] Classified findings for ${target_key}:"
    "${script_dir}/list-findings" "${target_key}" --console=plain || true
}

for harness_script in "${harness_scripts[@]}"; do
    printf '%s\n' "[JAZZER-WRAPPER] Starting ${harness_script}"
    "${script_dir}/${harness_script}" "$@"
    status=$?
    printf '%s\n' "[JAZZER-WRAPPER] Finished ${harness_script} with exit code ${status}"

    case "${status}" in
        0)
            ;;
        130|143)
            exit "${status}"
            ;;
        124)
            if [[ ${overall_status} -eq 0 ]]; then
                overall_status=124
            fi
            ;;
        *)
            overall_status=1
            print_classified_findings "${harness_script}"
            printf '%s\n' "[JAZZER-WRAPPER] Stopping after actionable failure in ${harness_script}."
            exit "${overall_status}"
            ;;
    esac
done

exit "${overall_status}"
