#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=./common.sh
. "${script_dir}/common.sh"

if fg_has_help_flag "$@"; then
    cat <<'EOF'
Usage: jazzer/bin/replay <target-key> <input-path> [--json] [supported Gradle options]

Replays one committed or ad hoc raw input through the selected Jazzer harness.
EOF
    fg_print_gradle_passthrough_help
    exit 0
fi

if [[ $# -lt 2 ]]; then
    printf '%s\n' "Usage: jazzer/bin/replay <target-key> <input-path> [--json] [supported Gradle options]" >&2
    exit 1
fi

target_key=$1
input_path=$2
shift 2

json_output=false
if [[ $# -gt 0 && "${1}" == "--json" ]]; then
    json_output=true
    shift
fi

fg_initialize_wrapper "$0"
input_path="$(fg_require_existing_regular_file_path "${input_path}")"
fg_require_replayable_target_key "${target_key}"
if [[ "${json_output}" == "true" ]]; then
    fg_run_machine_json_read_only_command "jazzerReplay" \
        "-PjazzerTarget=${target_key}" \
        "-PjazzerInput=${input_path}" \
        "-PjazzerJsonOutput=true" \
        "$@"
else
    fg_run_read_only_command "jazzerReplay" \
        "-PjazzerTarget=${target_key}" \
        "-PjazzerInput=${input_path}" \
        "$@"
fi
