<?xml version="1.0" encoding="UTF-8"?>
<ruleset
    name="FinGrind Java Test Quality"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/pmd-7.0.0/ruleset_xml_schema.xsd">
    <description>
        High-signal PMD rules for FinGrind Jazzer support and regression tests. Structural, design,
        performance, security, and concurrency checks stay aligned with repository-wide standards,
        while narrowly-scoped relaxations cover reflective fixtures and test-only failure plumbing.
    </description>

    <rule ref="category/java/errorprone.xml">
        <exclude name="AvoidCatchingGenericException"/>
        <exclude name="AvoidDuplicateLiterals"/>
        <exclude name="AvoidFieldNameMatchingMethodName"/>
        <exclude name="AvoidLiteralsInIfCondition"/>
        <exclude name="NullAssignment"/>
        <!-- Harness-side reflective fixtures intentionally widen access for white-box fault injection. -->
        <exclude name="AvoidAccessibilityAlteration"/>
    </rule>

    <rule ref="category/java/bestpractices.xml">
        <!-- Fault-injection helpers sometimes replace stack traces to assert normalized wrapper output. -->
        <exclude name="PreserveStackTrace"/>
        <!-- Jazzer regression tests optimize for assertion locality over repeated message boilerplate. -->
        <exclude name="UnitTestAssertionsShouldIncludeMessage"/>
        <!-- One regression often checks several correlated crash-shape facets in one executable flow. -->
        <exclude name="UnitTestContainsTooManyAsserts"/>
    </rule>

    <rule ref="category/java/design.xml">
        <!-- Demeter violations are too noisy for a layered facade API. -->
        <exclude name="LawOfDemeter"/>
        <!-- LoosePackageCoupling requires explicit package configurations to be useful. -->
        <exclude name="LoosePackageCoupling"/>
        <!-- DataClass produces false positives on well-structured value and command objects. -->
        <exclude name="DataClass"/>
        <!-- Test helpers legitimately import many assertion and fixture types. -->
        <exclude name="ExcessiveImports"/>
        <!-- Test classes legitimately contain many test methods. -->
        <exclude name="TooManyMethods"/>
        <exclude name="GodClass"/>
        <!-- File and method size governance lives in FinGrind's structural-governance engine rather than PMD's ambient NCSS defaults. -->
        <exclude name="NcssCount"/>
        <!-- Reflection-heavy tests sometimes declare broad throws clauses to keep fixture control flow readable. -->
        <exclude name="SignatureDeclareThrowsException"/>
        <!-- Some enum fixtures intentionally expose public wire-value factories on package-private types to simulate reflective contracts under test. -->
        <exclude name="PublicMemberInNonPublicType"/>
    </rule>

    <rule ref="category/java/design.xml/GodClass"/>

    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="methodReportLevel" value="18"/>
            <property name="classReportLevel" value="140"/>
        </properties>
    </rule>

    <rule ref="category/java/design.xml/CognitiveComplexity">
        <properties>
            <property name="reportLevel" value="22"/>
        </properties>
    </rule>

    <rule ref="category/java/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="threshold" value="72"/>
        </properties>
    </rule>

    <rule ref="category/java/multithreading.xml">
        <!-- Tests are allowed to create threads explicitly for concurrency scenarios. -->
        <exclude name="DoNotUseThreads"/>
    </rule>

    <rule ref="category/java/performance.xml"/>

    <rule ref="category/java/security.xml"/>

</ruleset>
