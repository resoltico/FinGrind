{
  "application": "FinGrind",
  "version": "${version}",
  "artifactType": "self-contained-cli-bundle",
  "archiveFormat": "${bundleArchiveFormat}",
  "runtimeDistribution": "${bundleRuntimeDistribution}",
  "publicCliDistribution": "${publicCliDistribution}",
  "bundleTarget": {
    "classifier": "${bundleClassifier}",
    "operatingSystem": "${bundleOperatingSystem}",
    "architecture": "${bundleArchitecture}"
  },
  "supportedPublicCliBundleTargets": ${publicBundleTargetsJson},
  "unsupportedPublicCliOperatingSystems": ${unsupportedPublicOperatingSystemsJson},
  "launcher": "${bundleLauncherPath}",
  "noExternalJavaRequired": true,
  "requiresFingrindSqliteLibraryEnvironmentVariable": false,
  "managedSqlite": {
    "storageDriver": "${storageDriver}",
    "storageEngine": "${storageEngine}",
    "bookProtectionMode": "${bookProtectionMode}",
    "defaultBookCipher": "${defaultBookCipher}",
    "libraryMode": "${sqliteLibraryMode}"
  },
  "bootstrap": {
    "recommendedFirstCommand": [
      "${bundleLauncherCommand}",
      "${helpOperation}"
    ],
    "machineReadableContractCommand": [
      "${bundleLauncherCommand}",
      "${capabilitiesOperation}"
    ],
    "requestTemplateCommand": [
      "${bundleLauncherCommand}",
      "${requestTemplateOperation}"
    ],
    "planTemplateCommand": [
      "${bundleLauncherCommand}",
      "${planTemplateOperation}"
    ]
  },
  "documentationFiles": [
    "README.md",
    "bundle-manifest.json",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "LICENSE-SIL-OFL-1.1",
    "LICENSE-SQLITE3MULTIPLECIPHERS",
    "NOTICE",
    "PATENTS.md"
  ]
}
