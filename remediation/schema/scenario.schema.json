    "expected": {"$ref": "urn:fingrind:ledger1:string-sequence"},
    "id": {"$ref": "urn:fingrind:ledger1:id"},
    "kind": {"pattern": "^(?:CANARY|PERSONA|JOURNEY|RELEASE_UAT|FAULT)$", "type": "string"},
